# Database
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/hostzero_status

# Payload
PAYLOAD_SECRET=your-super-secret-key-change-this-in-production

# Server
SERVER_URL=http://localhost:3000

# Language (optional)
# Language of the status page, admin, emails, SMS and feeds. Default: en.
# A change takes effect after a restart. Values: de, en, or the code of a file in LOCALES_DIR.
# DEFAULT_LANGUAGE=en
# Directory with additional language files (one JSON file per language, e.g. fr.json).
# LOCALES_DIR=/path/to/locales

# SSO/OIDC Authentication (optional)
# Uncomment and configure to enable SSO with Keycloak, Okta, Auth0, Azure AD, etc.
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_AUTH_URL=https://keycloak.example.com/realms/myrealm/protocol/openid-connect/auth
# OIDC_TOKEN_URL=https://keycloak.example.com/realms/myrealm/protocol/openid-connect/token
# OIDC_USERINFO_URL=https://keycloak.example.com/realms/myrealm/protocol/openid-connect/userinfo
# OIDC_SCOPES=openid profile email
# OIDC_AUTO_CREATE=true

# Group-based access control (optional)
# OIDC_ALLOWED_GROUPS=status-admins,status-editors
# OIDC_GROUP_CLAIM=groups

# SSO-only mode - disable password login (optional)
# OIDC_DISABLE_LOCAL_LOGIN=true

# Demo Mode (optional)
# WARNING: Demo mode is DESTRUCTIVE. It will delete and reseed all application
# data at the configured interval. Only enable on a dedicated / disposable
# database - NEVER on production data.
# DEMO_MODE=true
# DEMO_USER_EMAIL=demo@yasp.io
# DEMO_USER_PASSWORD=demo2026#
# DEMO_RESET_INTERVAL_MINUTES=60

# Switch off "Maintain the status log" (optional): hides the page and blocks the
# routes that rebuild the log or convert maintenances (HTTP 403). Reports are unaffected.
# DISABLE_STATUS_LOG_MAINTENANCE=true
