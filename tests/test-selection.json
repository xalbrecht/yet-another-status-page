{
  "beschreibung": "Ordnet Pfade im Quellcode den E2E-Tags zu (Issue #211). Der erste passende Eintrag gilt, genauere Muster stehen deshalb vor allgemeinen. \"*\" bedeutet: volle Suite. Geprüft wird mit npm run check:test-selection.",
  "geprueftePfade": ["src/**", "payload.config.ts", "locales/**"],
  "tags": {
    "ebene": ["@admin", "@public", "@api"],
    "bereich": [
      "@statusseite", "@lagebild", "@stoerungen", "@wartungen", "@vorlagen", "@dienste",
      "@bericht", "@statusprotokoll", "@abonnenten", "@schnittstelle", "@system"
    ]
  },
  "pfade": {
    "src/migrations/**": ["*"],
    "src/payload-types.ts": ["*"],
    "src/instrumentation.ts": ["@wartungen"],
    "src/tasks/**": ["*"],

    "src/collections/Incidents.ts": ["@stoerungen", "@statusseite", "@lagebild", "@schnittstelle"],
    "src/collections/Maintenances.ts": ["@wartungen", "@statusseite", "@lagebild", "@schnittstelle"],
    "src/collections/MessageTemplates.ts": ["@vorlagen"],
    "src/collections/Notifications.ts": ["@abonnenten"],
    "src/collections/ServiceGroups.ts": ["@dienste", "@statusseite", "@lagebild", "@bericht"],
    "src/collections/Services.ts": ["@dienste", "@statusseite", "@lagebild", "@bericht"],
    "src/collections/ServiceStatusEvents.ts": ["@statusprotokoll", "@bericht", "@lagebild"],
    "src/collections/Subscribers.ts": ["@abonnenten", "@system"],
    "src/collections/Users.ts": ["*"],
    "src/collections/Media.ts": ["@system"],
    "src/collections/index.ts": ["*"],
    "src/globals/**": ["*"],

    "src/app/(frontend)/history/**": ["@statusseite"],
    "src/app/(frontend)/i/**": ["@stoerungen"],
    "src/app/(frontend)/m/**": ["@wartungen"],
    "src/app/(frontend)/confirm/**": ["@abonnenten"],
    "src/app/(frontend)/unsubscribe/**": ["@abonnenten"],
    "src/app/(frontend)/page.tsx": ["@statusseite", "@lagebild"],
    "src/app/(frontend)/*": ["@public"],
    "src/app/(payload)/**": ["@admin"],
    "src/app/feed.atom/**": ["@schnittstelle"],
    "src/app/maintenances.ics/**": ["@schnittstelle"],
    "src/app/*.tsx": ["@public"],

    "src/app/api/availability-report/**": ["@bericht"],
    "src/app/api/dashboard-stats/**": ["@system"],
    "src/app/api/demo-status/**": ["@system"],
    "src/app/api/health/**": ["@schnittstelle"],
    "src/app/api/incidents/**": ["@stoerungen", "@vorlagen"],
    "src/app/api/maintenances/**": ["@wartungen", "@vorlagen"],
    "src/app/api/notifications/**": ["@abonnenten"],
    "src/app/api/status-log/**": ["@statusprotokoll"],
    "src/app/api/subscribe/**": ["@abonnenten"],
    "src/app/api/unsubscribe/**": ["@abonnenten"],
    "src/app/api/subscribers/**": ["@abonnenten"],
    "src/app/api/subscription/**": ["@abonnenten"],
    "src/app/api/system-info/**": ["@system"],
    "src/app/api/v1/**": ["@schnittstelle"],

    "src/components/admin/availability-report/**": ["@bericht"],
    "src/components/admin/incident-wizard/**": ["@stoerungen", "@wartungen", "@vorlagen"],
    "src/components/admin/status-log/**": ["@statusprotokoll"],
    "src/components/admin/update-template/**": ["@vorlagen", "@stoerungen", "@wartungen"],
    "src/components/admin/group-icon-field/**": ["@dienste"],
    "src/components/admin/ServiceChoices*": ["@admin", "@stoerungen", "@dienste"],
    "src/components/admin/Service*": ["@dienste"],
    "src/components/admin/SystemInfo*": ["@system"],
    "src/components/admin/Dashboard*": ["@system"],
    "src/components/admin/Demo*": ["@system"],
    "src/components/admin/LocalizedDateField.tsx": ["@system"],
    "src/components/admin/RecipientCountField*": ["@abonnenten"],
    "src/components/admin/SendNotification*": ["@abonnenten"],
    "src/components/status/lagebild/**": ["@lagebild"],
    "src/components/status/StatusBoxes.tsx": ["@statusseite"],
    "src/components/status/**": ["@public"],
    "src/components/*": ["@public"],

    "src/lib/report/**": ["@bericht"],
    "src/lib/api/**": ["@schnittstelle"],
    "src/lib/feeds/**": ["@schnittstelle"],
    "src/lib/i18n/**": ["*"],
    "src/lib/maintenance/**": ["@wartungen"],
    "src/lib/notifications/**": ["@abonnenten"],
    "src/lib/lagebild*.ts": ["@lagebild"],
    "src/lib/status-boxes.ts": ["@statusseite"],
    "src/lib/maintenance-*.ts": ["@wartungen"],
    "src/lib/message-templates.ts": ["@vorlagen"],
    "src/lib/template-text.ts": ["@vorlagen"],
    "src/lib/update-template.ts": ["@vorlagen"],
    "src/lib/incident-draft.ts": ["@vorlagen"],
    "src/lib/service-lifecycle.ts": ["@dienste", "@stoerungen", "@wartungen"],
    "src/lib/affected-services.ts": ["@dienste", "@stoerungen", "@wartungen"],
    "src/lib/status-log-*.ts": ["@statusprotokoll"],
    "src/lib/status-reconstruction.ts": ["@statusprotokoll"],
    "src/lib/service-status-sync.ts": ["@statusprotokoll", "@stoerungen", "@dienste"],
    "src/lib/service-choices.ts": ["@stoerungen", "@dienste"],
    "src/lib/sms*.ts": ["@abonnenten"],
    "src/lib/email.ts": ["@abonnenten"],
    "src/lib/subscriber-filter.ts": ["@abonnenten"],
    "src/lib/system-info.ts": ["@system"],
    "src/lib/group-icon*.ts": ["@dienste"],
    "src/lib/icon-picker.ts": ["@dienste"],
    "src/lib/*.ts": ["*"],

    "payload.config.ts": ["*"],
    "locales/**": ["*"]
  }
}
